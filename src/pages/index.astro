---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = posts.slice(0, 5);
---

<Base title="AssagraIsRoot.dev">
  <section class="hero">
    <p class="hero-tag">// engenharia de software</p>
    <h1 class="hero-title">
      Aprendendo em público, uma linha de código por vez.
    </h1>
    <p class="hero-subtitle">
      Notas técnicas sobre Java e internals da JVM, arquitetura de software,
      containers, Linux e segurança da informação — escritas enquanto eu
      desço a pilha para entender como as coisas funcionam por baixo.
    </p>
  </section>

  <section class="latest">
    <header class="section-header">
      <h2 class="section-title">Artigos recentes</h2>
      <a href="/blog" class="section-link">Ver todos os artigos →</a>
    </header>

    {
      recentPosts.length === 0 ? (
        <p class="empty">Nenhum artigo publicado ainda. Em breve.</p>
      ) : (
        <div class="post-list">
          {recentPosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.slug}
              tags={post.data.tags}
            />
          ))}
        </div>
      )
    }
  </section>

  <style>
    .hero {
      padding: 1.5rem 0 3rem;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 2.5rem;
    }
    .hero-tag {
      font-family: var(--font-mono);
      color: var(--color-accent);
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
    .hero-title {
      font-size: 2.4rem;
      line-height: 1.15;
      margin: 0 0 1.1rem;
      letter-spacing: -0.02em;
    }
    .hero-subtitle {
      color: var(--color-text-muted);
      font-size: 1.1rem;
      max-width: 60ch;
      margin: 0;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.4rem;
    }
    .section-title {
      margin: 0;
      font-size: 1.4rem;
    }
    .section-link {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .post-list {
      display: grid;
      gap: 1rem;
    }

    .empty {
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: 0.9rem;
    }

    @media (max-width: 480px) {
      .hero-title {
        font-size: 1.9rem;
      }
    }
  </style>
</Base>
