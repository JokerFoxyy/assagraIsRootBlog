---
export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
const isoDate = pubDate.toISOString();
---

<article class="post-card" data-tags={tags.join(',')}>
  <a href={`/blog/${slug}`} class="card-link">
    <time datetime={isoDate} class="card-date">{formattedDate}</time>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
  </a>
  {
    tags.length > 0 && (
      <ul class="card-tags">
        {tags.map((tag) => (
          <li>
            <a href={`/tags/${tag}`} class="card-tag">
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
    padding: 1.25rem 1.4rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .card-link {
    display: block;
    color: inherit;
  }
  .card-link:hover {
    text-decoration: none;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .card-title {
    margin: 0.35rem 0 0.4rem;
    font-size: 1.2rem;
    color: var(--color-text);
  }
  .post-card:hover .card-title {
    color: var(--color-accent);
  }

  .card-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.9rem 0 0;
    padding: 0;
  }
  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    background-color: var(--color-bg);
  }
  .card-tag:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    text-decoration: none;
  }
</style>
